{
  "name": "itazu-rush",
  "private": true,
  "description": "いたずラッシュの自動テスト（ゲーム本体は index.html だけで動き、これは不要）",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:full": "node --test --test-concurrency=1 --test-timeout=600000 tests/*.test.js"
  },
  "devDependencies": {
    "puppeteer-core": "25.13.0"
  }
}
